{
  "name": "drop-rush-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migration:create": "sequelize-cli migration:generate --name",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "jsonwebtoken": "9.0.2",
    "node-cron": "4.6.0",
    "pg": "8.23.0",
    "sequelize": "6.37.8",
    "socket.io": "4.8.3",
    "uuid": "13.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.3.0",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.11.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "sequelize-cli": "6.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0"
  }
}
