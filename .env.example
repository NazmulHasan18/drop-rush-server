# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Neon / any Postgres works)
DATABASE_URL=postgresql://user:password@localhost:5432/sneaker_drop
DB_SSL=false

# Auth
JWT_SECRET=change-this-super-secret-key
JWT_EXPIRES_IN=7d

# Reservation
RESERVATION_TTL_SECONDS=60
EXPIRY_SWEEP_CRON=*/2 * * * * *
