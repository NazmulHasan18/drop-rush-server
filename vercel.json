{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    },
    "api/cron/expire-sweep.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/cron/expire-sweep).*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-sweep",
      "schedule": "* * * * *"
    }
  ]
}
